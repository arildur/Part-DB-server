{% import "helper.twig" as helper %}

{# The rows of a lot table. Rows of an own lot get the stock buttons; read-only rows (the lots of a connected part on a
   meta part) do not, as they belong to that part. not_counted marks every lot as left out of the total. #}
{% macro lot_rows(lots, lot_part, options) %}
    {% import "helper.twig" as helper %}
    {% import "label_system/dropdown_macro.html.twig" as dropdown %}
    {% set read_only = options.read_only ?? false %}
    {% for lot in lots %}
        {# @var lot App\Entity\Parts\PartLot #}
        <tr {% if lot.id == options.highlight_lot_id %}class="table-primary row-highlight row-pulse"{% endif %}>
            <td>{{ lot.description }}</td>
            <td>
                {% if lot.storageLocation %}
                    {{ helper.structural_entity_link(lot.storageLocation) }}
                {% else %}
                    <span class="badge rounded-pill text-bg-warning">
                    <i class="fas fa-question-circle fa-fw"></i> {% trans %}part_lots.location_unknown{% endtrans %}
                </span>
                {% endif %}
            </td>
            <td>
                {% if lot.instockUnknown %}
                    <span class="badge rounded-pill text-bg-warning">
                    <i class="fas fa-question-circle fa-fw"></i> {% trans %}part_lots.instock_unknown{% endtrans %}
                </span>
                {% else %}
                    {{ lot.amount | format_amount(lot_part.partUnit, {'decimals': 5}) }}
                {% endif %}
            </td>
            <td {% if read_only %}colspan="4"{% endif %}>
                <div class="d-flex flex-column align-items-start">
                    {% if lot.owner  %}
                        <span class="badge text-bg-light mb-1" title="{% trans %}part_lot.owner{% endtrans %}">
                            {{ helper.user_icon_link(lot.owner) }}
                        </span>
                    {% endif %}
                    {% if lot.expirationDate %}
                        <span class="badge text-bg-info mb-1" title="{% trans %}part_lots.expiration_date{% endtrans %}">
                        <i class="fas fa-calendar-alt fa-fw"></i> {{ lot.expirationDate | format_date() }}<br>
                    </span>
                    {% endif %}
                    {% if lot.expired %}
                        <span class="badge text-bg-warning mb-1">
                        <i class="fas fa-exclamation-circle fa-fw"></i>
                        {% trans %}part_lots.is_expired{% endtrans %}
                    </span>
                    {% endif %}
                    {% if options.mark_not_counted and (lot.expired or lot.instockUnknown or (options.not_counted ?? false)) %}
                        <span class="badge text-bg-secondary mb-1">{% trans %}part_lots.not_counted{% endtrans %}</span>
                    {% endif %}
                    {% if lot.needsRefill %}
                        <span class="badge text-bg-warning mb-1">
                            <i class="fas fa-dolly fa-fw"></i>
                            {% trans %}part_lots.need_refill{% endtrans %}
                        </span>
                    {% endif %}
                    {% if lot.lastStocktakeAt %}
                        <span class="badge text-bg-secondary" title="{% trans %}part_lot.edit.last_stocktake_at{% endtrans %}">
                            <i class="fas fa-clipboard-check fa-fw"></i>
                            {{ lot.lastStocktakeAt | format_datetime("short") }}
                        </span>
                    {% endif %}
                </div>
            </td>
            {% if not read_only %}
            <td>
                <div class="btn-group" role="group">
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#withdraw-modal"
                            data-action="withdraw" data-lot-id="{{ lot.id }}" data-lot-amount="{{ lot.amount }}"
                            title="{% trans %}part.info.withdraw_modal.title.withdraw{% endtrans %}"
                            {% if not is_granted('withdraw', lot) or not options.withdraw_add_helper.canWithdraw(lot) %}disabled{% endif %}
                    >
                        <i class="fa-solid fa-minus fa-fw"></i>
                    </button>
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#withdraw-modal"
                            data-action="add" data-lot-id="{{ lot.id }}" data-lot-amount="{{ lot.amount }}"
                            title="{% trans %}part.info.withdraw_modal.title.add{% endtrans %}"
                            {% if not is_granted('add', lot) or not options.withdraw_add_helper.canAdd(lot) %}disabled{% endif %}
                    >
                        <i class="fa-solid fa-plus fa-fw"></i>
                    </button>
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#withdraw-modal"
                            data-action="move" data-lot-id="{{ lot.id }}" data-lot-amount="{{ lot.amount }}"
                            title="{% trans %}part.info.withdraw_modal.title.move{% endtrans %}"
                            {% if not is_granted('move', lot) or not options.withdraw_add_helper.canWithdraw(lot) %}disabled{% endif %}
                    >
                        <i class="fa-solid fa-right-left fa-fw"></i>
                    </button>

                    <button type="button" class="btn-primary btn" data-bs-toggle="modal" data-bs-target="#stocktake-modal" title="{% trans %}part.info.stocktake_modal.title{% endtrans %}"
                            {% if not is_granted('stocktake', lot) %}disabled{% endif %}
                            data-lot-id="{{ lot.id }}" data-lot-amount="{{ lot.amount }}"><i class="fas fa-clipboard-check fa-fw"></i></button>
                </div>
            </td>
            <td>
                {{ dropdown.profile_dropdown('part_lot', lot.id, false) }}
            </td>
            <td> {# Action for order information #}
                <div class="btn-group">
                    <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <i class="fa-solid fa-lightbulb fa-fw"></i>
                    </button>
                    <div class="dropdown-menu">
                        <span class="text-muted dropdown-item-text" ><i class="fas fa-lightbulb fa-fw"></i> <b>{% trans %}id.label{% endtrans %}:</b> {{ lot.iD }}</span>
                        <span class="text-muted dropdown-item-text" ><i class="fas fa-history fa-fw"></i> <b>{% trans %}lastModified{% endtrans %}:</b> {{ helper.entity_last_modified(lot) }}</span>
                        <span class="text-muted dropdown-item-text" ><i class="fas fa-calendar-plus fa-fw"></i> <b>{% trans %}createdAt{% endtrans %}:</b> {{ helper.entity_created_at(lot) }}</span>
                        {% if lot.comment is not empty %}
                            <span class="text-muted dropdown-item-text" ><i class="fas fa-sticky-note fa-fw"></i> <b>{% trans %}part_lot.edit.comment{% endtrans %}:</b> {{ lot.comment }}</span>
                        {% endif %}
                    </div>
                </div>
            </td>
            {% endif %}
        </tr>
    {% endfor %}
{% endmacro %}

{% macro lot_table_head() %}
    <thead>
    <tr>
        <th>{% trans %}part_lots.description{% endtrans %}</th>
        <th>{% trans %}part_lots.storage_location{% endtrans %}</th>
        <th>{% trans %}part_lots.amount{% endtrans %}</th>
        <th></th> {# Tags row #}
        <th></th>
        <th></th> {# Button row #}
        <th></th>
    </tr>
    </thead>
{% endmacro %}

{# The distinct storage locations of the given lots, each linked, and a mark when a lot has none #}
{% macro lot_locations(lots) %}
    {% set locations = {} %}
    {% set unknown = false %}
    {% for lot in lots %}
        {% if lot.storageLocation %}
            {% set locations = locations|merge({('l' ~ lot.storageLocation.id): lot.storageLocation}) %}
        {% else %}
            {% set unknown = true %}
        {% endif %}
    {% endfor %}
    {%- for location in locations -%}
        <a href="{{ entity_url(location, 'list_parts') }}" title="{{ location.fullPath }}">{{ location.name }}</a>{% if not loop.last %}, {% endif %}
    {%- endfor -%}
    {% if unknown %}
        <span class="badge rounded-pill text-bg-warning"><i class="fas fa-question-circle fa-fw"></i> {% trans %}part_lots.location_unknown{% endtrans %}</span>
    {% endif %}
{% endmacro %}

{% include "parts/info/_withdraw_modal.html.twig" %}
{% include "parts/info/_stocktake_modal.html.twig" %}
{% include "parts/info/_add_lot_modal.html.twig" %}

{% set lot_options = {highlight_lot_id: highlightLotId, withdraw_add_helper: withdraw_add_helper, mark_not_counted: part.kind.allowsConnections} %}

{% if part.kind.allowsConnections %}
    {% if timeTravel is defined and timeTravel is not null %}
        <div class="alert alert-warning">{% trans %}part_lots.connected_stock_is_current{% endtrans %}</div>
    {% endif %}
    {# One row per part whose stock the meta part shows: its own stock pinned first, then each connected part in the
       order of the connections. A part's lots are in a detail row below it, which the sorting keeps with it. #}
    <div class="table-responsive">
        <table class="table table-hover align-middle" data-controller="elements--sortable-table elements--expandable-rows">
            <thead>
            <tr>
                <th data-sortable="false">
                    <button type="button" class="btn btn-link btn-sm p-0 text-reset" data-elements--expandable-rows-target="all"
                            data-action="elements--expandable-rows#toggleAll" aria-expanded="false"
                            data-label-expand="{% trans %}part_lots.expand_all{% endtrans %}" data-label-collapse="{% trans %}part_lots.collapse_all{% endtrans %}"
                            aria-label="{% trans %}part_lots.expand_all{% endtrans %}">
                        <i class="fas fa-angles-right fa-fw" aria-hidden="true"></i>
                    </button>
                </th>
                <th>{% trans %}manufacturer.label{% endtrans %}</th>
                <th>{% trans %}part.table.mpn{% endtrans %}</th>
                <th>{% trans %}part_connection.table.part{% endtrans %}</th>
                <th>{% trans %}part_connection.edit.status{% endtrans %}</th>
                <th>{% trans %}part_lots.stock{% endtrans %}</th>
                <th>{% trans %}part_lots.lot_count{% endtrans %}</th>
                <th>{% trans %}storelocation.labelp{% endtrans %}</th>
            </tr>
            </thead>
            <tbody>
            {% set groups = [{part: part, connection: null}] %}
            {% for connection in part.orderedConnections %}
                {% set groups = groups|merge([{part: connection.connectedPart, connection: connection}]) %}
            {% endfor %}
            {% for group in groups %}
                {% set group_part = group.part %}
                {% set connection = group.connection %}
                {% set lots = group_part.partLots %}
                {% set detail_id = 'part-lots-detail-' ~ group_part.id %}
                {# All collapsed at first, except the part holding a lot just added or changed, so that it shows #}
                {% set expanded = false %}
                {% for lot in lots %}
                    {% if lot.id == highlightLotId %}{% set expanded = true %}{% endif %}
                {% endfor %}
                {% if connection is null %}
                    <tr class="table-secondary" data-sortable-pinned="top" data-stock-row="own">
                {% else %}
                    <tr data-stock-row="connected">
                {% endif %}
                    <td>
                        {% if lots is not empty %}
                            <button type="button" class="btn btn-link btn-sm p-0 text-reset" data-elements--expandable-rows-target="toggle"
                                    data-action="elements--expandable-rows#toggle" aria-controls="{{ detail_id }}"
                                    aria-expanded="{{ expanded ? 'true' : 'false' }}"
                                    aria-label="{% trans %}part_lots.show_lots{% endtrans %}">
                                <i class="fas {{ expanded ? 'fa-chevron-down' : 'fa-chevron-right' }} fa-fw" aria-hidden="true"></i>
                            </button>
                        {% endif %}
                    </td>
                    {% if connection is null %}
                        <th colspan="4">{% trans %}part_lots.own_stock{% endtrans %}</th>
                        <td data-sort-value="{{ part.ownAmountSum }}">{{ part.ownAmountSum | format_amount(part.partUnit, {'decimals': 5}) }}</td>
                    {% else %}
                        <td>
                            {%- if group_part.manufacturer -%}
                                <a href="{{ entity_url(group_part.manufacturer, 'list_parts') }}">{{ group_part.manufacturer.name }}</a>
                            {%- endif -%}
                        </td>
                        <td>{{ group_part.manufacturerProductNumber }}</td>
                        <td>{{ helper.part_icon_link(group_part) }}</td>
                        <td data-sort-value="{{ connection.status.restrictionRank }}">{{ helper.connection_status_badge(connection) }}</td>
                        <td data-sort-value="{{ group_part.amountSum }}">
                            {{ group_part.amountSum | format_amount(group_part.partUnit, {'decimals': 5}) }}
                            {% if not connection.usable %}
                                <span class="badge text-bg-secondary">{% trans %}part_lots.not_counted{% endtrans %}</span>
                            {% endif %}
                        </td>
                    {% endif %}
                    <td data-sort-value="{{ lots | length }}">{{ lots | length }}</td>
                    <td>{{ _self.lot_locations(lots) }}</td>
                </tr>
                {% if lots is not empty %}
                    <tr id="{{ detail_id }}" data-sortable-detail {% if not expanded %}hidden{% endif %}>
                        <td></td>
                        <td colspan="7" class="p-0">
                            <table class="table table-sm table-striped mb-0">
                                {{ _self.lot_table_head() }}
                                <tbody>
                                {% if connection is null %}
                                    {{ _self.lot_rows(lots, part, lot_options) }}
                                {% else %}
                                    {# Lots of connected parts belong to those parts, so they have no stock buttons here; the part row links there #}
                                    {{ _self.lot_rows(lots, group_part, lot_options|merge({read_only: true, not_counted: not connection.usable})) }}
                                {% endif %}
                                </tbody>
                            </table>
                        </td>
                    </tr>
                {% endif %}
            {% endfor %}
            </tbody>
            <tfoot>
                <tr class="table-primary">
                    <td></td>
                    <th colspan="4">{% trans %}part_lots.total{% endtrans %}</th>
                    <th colspan="3">{{ part.amountSum | format_amount(part.partUnit, {'decimals': 5}) }}</th>
                </tr>
            </tfoot>
        </table>
    </div>
{% else %}
<div class="table-responsive">
    <table class="table table-striped table-hover">
        {{ _self.lot_table_head() }}
        <tbody>
        {{ _self.lot_rows(part.partLots, part, lot_options) }}
        </tbody>
    </table>
</div>
{% endif %}

{% if add_lot_form is not null %}
<button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#add-lot-modal">
    <i class="fas fa-plus-square fa-fw"></i>
    {% trans %}part_lot.create{% endtrans %}
</button>
{% endif %}
