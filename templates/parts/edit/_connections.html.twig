{% form_theme form with ['parts/edit/edit_form_styles.html.twig'] %}
{% import 'components/collection_type.macro.html.twig' as collection %}

<div {{ collection.controller(form.part_connections, 'part_connection.edit.delete.confirm') }}>
    <table class="table table-striped table-sm" id="connection_table" {{ collection.target() }}>
        <tbody>
        {% for connection in form.part_connections %}
            {{ form_widget(connection) }}
        {% endfor %}
        </tbody>
    </table>

    <button type="button" class="btn btn-success" {{ collection.create_btn() }}
            {% if not is_granted('edit', part) %}disabled{% endif %}>
        <i class="fas fa-plus-square fa-fw"></i>
        {% trans %}part_connection.edit.create{% endtrans %}
    </button>
</div>
