{% import "helper.twig" as helper %}

{{ form_start(form) }}

{{ form_errors(form) }}

{% set short_entries = buildHelper.nonBuildableProjectBomEntries(project, number_of_builds) %}

<table class="table table-sm table-responsive table-hover">
    <thead>
    <tr>
        <th>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" value="" data-multicheck-name="lots_check" {{ stimulus_controller('pages/checkbox_multicheck') }}>
            </div>
        </th>
        <th>{% trans %}part.table.name{% endtrans %}</th>
        <th>{% trans %}project.bom.mountnames{% endtrans %}</th>
        <th class="text-end">{% trans %}project.build.required_qty{% endtrans %}</th>
    </tr>
    </thead>
    <tbody>
    {% for bom_entry in build_request.bomEntries %}
        {# 1st row basic infos about the BOM entry #}
        <tr class="{% if bom_entry in short_entries %}table-danger{% else %}table-primary{% endif %}">
            <td style="width: 20px;">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" value="" data-multicheck-name="lots_check" required>
                    {# <label class="form-check-label" for="checkbox_{{ loop.index }}">  #}
                </div>
            </td>
            <td >
                {% if bom_entry.part %}
                    <b>{{ part_name(bom_entry.part, true, {target: '_blank'}) }}</b> {% if bom_entry.name %}({{ bom_entry.name }}){% endif %}
                {% else %}
                    <b>{{ bom_entry.name }}</b>
                {% endif %}
            </td>
            <td>
                {% for tag in bom_entry.mountnames|split(',') %}
                    <span class="badge bg-secondary badge-secondary" >{{ tag | trim }}</span>
                {% endfor %}
            </td>
            <td class="text-end">
                <b>{{ build_request.neededAmountForBOMEntry(bom_entry) | format_amount(bom_entry.part.partUnit ?? null) }}</b> {% trans %}project.builds.needed{% endtrans %}
                (= {{ number_of_builds }} x {{ bom_entry.quantity | format_amount(bom_entry.part.partUnit ?? null) }})
            </td>
        </tr>
        <tr>
            <td colspan="4">
                {% set lots = build_request.partLotsForBOMEntry(bom_entry) %}
                {% if lots is not null %}
                    {% set is_meta = bom_entry.part.kind.allowsConnections %}
                    {% set shown_part = null %}
                    {% for lot in lots %}
                        {# @var lot \App\Entity\Parts\PartLot #}
                        {% if is_meta and lot.part != shown_part %}
                            {% set shown_part = lot.part %}
                            <div class="fw-semibold mb-1">
                                {% if lot.part == bom_entry.part %}
                                    {% trans %}project.build.meta_part_own_lots{% endtrans %}
                                {% else %}
                                    {{ part_name(lot.part, true, {target: '_blank'}) }}
                                {% endif %}
                            </div>
                        {% endif %}
                        <div class="mb-2 row">
                            <label class="col-form-label col-sm-4" for="{{ form['entry_'~bom_entry.id~'_lot_'~lot.id].vars.id }}">
                                {% if lot.storageLocation %}
                                    <small>{{ helper.structural_entity_link(lot.storageLocation) }}</small>
                                {% endif %}
                                {% if lot.name is not empty %}
                                    (<small>{{ lot.name }}</small>)
                                {% endif %}
                                {% set others = build_request.otherEntriesReachingLot(bom_entry, lot) %}
                                {% if others is not empty %}
                                    <br><small class="text-warning-emphasis"><i class="fa-solid fa-share-nodes fa-fw"></i>
                                        {% trans %}project.build.lot_shared_with{% endtrans %}:
                                        {% for other in others %}{{ part_name(other.part, false) }}{% if other.mountnames is not empty %} ({{ other.mountnames }}){% endif %}{% if not loop.last %}, {% endif %}{% endfor %}
                                    </small>
                                {% endif %}
                            </label>
                            <div class="col-sm-6">
                                {{ form_errors(form['entry_'~bom_entry.id~'_lot_'~lot.id]) }}
                                {{ form_widget(form['entry_'~bom_entry.id~'_lot_'~lot.id]) }}
                            </div>
                            <div class="col-sm-2 mt-1  text-end">
                                / <b>{{ lot.amount | format_amount(lot.part.partUnit) }}</b> {% trans %}project.builds.stocked{% endtrans %}
                            </div>
                        </div>
                    {% endfor %}
                    {% if is_meta %}
                        {% for connection in bom_entry.part.orderedConnections %}
                            {% if not connection.usable %}
                                <div class="mb-2 text-muted">
                                    <s>{{ part_name(connection.connectedPart, true, {target: '_blank'}) }}</s>
                                    {{ helper.connection_status_badge(connection) }}
                                    {% if connection.note is not empty %}<small>{{ connection.note }}</small>{% endif %}
                                </div>
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                {% endif %}
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>

{{ form_row(form.comment) }}
<div {{ stimulus_controller('pages/dont_check_quantity_checkbox') }}>
{{ form_row(form.dontCheckQuantity) }}
</div>

{{ form_row(form.addBuildsToBuildsPart) }}
{% if form.buildsPartLot is defined %}
    {{ form_row(form.buildsPartLot) }}
{% endif %}

{{ form_row(form.submit) }}

{{ form_end(form) }}