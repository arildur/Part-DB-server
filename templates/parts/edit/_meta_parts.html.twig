{% form_theme form with ['parts/edit/edit_form_styles.html.twig'] %}
{% import 'components/collection_type.macro.html.twig' as collection %}

<div {{ collection.controller(form.connections_as_part, 'part_connection.edit.delete.confirm') }}>
    {{ form_errors(form.connections_as_part) }}
    <table class="table table-striped table-sm" id="meta_part_connection_table" {{ collection.target() }}>
        <tbody>
        {% for connection in form.connections_as_part %}
            {{ form_widget(connection) }}
        {% endfor %}
        </tbody>
    </table>

    <button type="button" class="btn btn-success" {{ collection.create_btn() }}>
        <i class="fas fa-plus-square fa-fw"></i>
        {% trans %}part_connection.edit.create_meta_part{% endtrans %}
    </button>
</div>
